# Live Orvix API key with ai:invoke. Image debit uses prepaid SKU
# orvix-image-credits-100 (seeded off-storefront). Do not invent.
ORV_KEY=

# Default https://api.orvix.id
ORV_API_BASE=https://api.orvix.id

# flux-2-pro | qwen-image-3.0 | seedream-5.0-pro | gpt-image-2 | gemini-3-pro-image | all
ORV_MODEL=flux-2-pro

ORV_PROMPT=a red circle on white
# Optional OpenAI-shaped extras (leave empty to omit)
ORV_SIZE=
ORV_QUALITY=
ORV_OUT_DIR=outputs
